{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "self-service-ui values",
  "type": "object",
  "additionalProperties": false,
  "required": ["selfServiceUI", "auth", "ingress"],
  "properties": {
    "global": {
      "type": "object",
      "description": "Injected by Helm into every subchart. Must be tolerated here, or this chart cannot be used as a dependency at all, because additionalProperties is false."
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": {
      "type": "string",
      "description": "Pins the resource base name. The umbrella chart sets this so adopting these releases does not rename every object."
    },
    "selfServiceUI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "version", "hostname"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "imagePullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "version": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "replicas": { "type": "integer", "minimum": 0 },
        "dynamicZonesBaseUrl": { "type": "string" },
        "cloudResourcesBaseUrl": { "type": "string" },
        "acmeServer": { "type": "string" },
        "dynamicZonesUpstream": { "type": "string" },
        "cloudResourcesUpstream": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oidc"],
      "properties": {
        "provider": { "type": "string" },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuerUrl", "clientId"],
          "properties": {
            "issuerUrl": { "type": "string", "minLength": 1 },
            "clientId": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
